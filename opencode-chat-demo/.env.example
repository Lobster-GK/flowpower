# Node API
PORT=3000

# OpenCode server managed by the Node API
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096
OPENCODE_START_TIMEOUT_MS=30000
OPENCODE_REQUEST_TIMEOUT_MS=600000

# Defaults to ./opencode-workspace. Relative paths are resolved from this demo root.
# OPENCODE_WORKSPACE=./opencode-workspace

# Optional. If omitted, OpenCode uses the default model from its own configuration.
# Format: provider/model
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5

# Optional OpenCode agent name.
# OPENCODE_AGENT=build

# Provider credentials can be supplied as normal OpenCode environment variables.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

