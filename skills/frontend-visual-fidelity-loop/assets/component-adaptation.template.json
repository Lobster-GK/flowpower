{
  "kind": "component-adaptation",
  "schemaVersion": "1.0",
  "visualContract": "01-visual-contract.json",
  "library": {
    "name": "visual-lab-native",
    "version": "browser",
    "themeEntrypoint": "visual-lab/src/runtime.css"
  },
  "mappings": [
    {
      "elementId": "page-title",
      "component": "h1",
      "source": "native-html",
      "composition": "page-root > page-title",
      "semanticFit": 0.95,
      "styleCompatibility": 0.75,
      "decision": "headless-or-native",
      "behaviorOwnership": "native-element",
      "dataOwnership": "static-content",
      "styleOwnership": {
        "geometry": "page layout class",
        "typography": "generated-ui.css",
        "surface": "not-applicable"
      },
      "requiredOverrides": {
        "fontSize": 20,
        "fontWeight": 600,
        "lineHeight": 28,
        "margin": 0
      },
      "overrideEntrypoints": ["generated-ui.css page-scoped selector"],
      "acceptancePolicy": {
        "profile": "component-faithful",
        "geometryTolerancePx": { "position": 4, "size": 4 },
        "minimumIou": 0.88,
        "typographyTolerance": {
          "fontSizePx": 1.5,
          "lineHeightPx": 2,
          "fontWeight": 100
        },
        "allowedLibraryVariations": [
          {
            "property": "glyph-antialiasing",
            "maximumDelta": null,
            "invariant": "text bbox, content, font size, weight and line height remain within policy",
            "reason": "browser and platform rasterization may differ"
          }
        ],
        "nonNegotiable": ["present", "visible", "content", "state", "no-overflow", "no-occlusion"]
      },
      "visualRisks": ["default heading margin"],
      "evidence": ["visual-contract:page-title", "component-documentation"]
    }
  ],
  "openQuestions": [],
  "validation": {
    "allRequiredElementsMapped": true,
    "allOverridesHaveEntrypoints": true,
    "noUnownedCriticalStyles": true,
    "noBlockingCompatibilityRisk": true
  }
}
