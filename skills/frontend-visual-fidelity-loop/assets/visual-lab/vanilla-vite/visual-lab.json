{
  "kind": "visual-lab-manifest",
  "schemaVersion": "1.0",
  "labId": "replace-with-task-id",
  "executionScope": "sandbox-only",
  "template": "vanilla-vite",
  "reference": "../reference.png",
  "rootSelector": "[data-visual-id='page-root']",
  "server": {
    "host": "127.0.0.1",
    "port": 4173,
    "path": "/"
  },
  "render": {
    "viewport": { "width": 1440, "height": 900 },
    "dpr": 1,
    "zoom": 1
  },
  "fixture": {
    "path": "src/visual-fixture.json",
    "mode": "static-json",
    "networkAccess": "forbidden"
  },
  "sourceFiles": [
    "visual-lab.json",
    "package.json",
    "index.html",
    "src/main.js",
    "src/runtime.css",
    "src/generated-ui.js",
    "src/generated-ui.css",
    "src/visual-fixture.json"
  ],
  "dependencyPolicy": {
    "allowedRuntimeDependencies": [],
    "allowedDevDependencies": ["vite"]
  },
  "determinism": {
    "freezeTime": true,
    "freezeRandom": true,
    "disableAnimations": true,
    "localAssetsOnly": true
  },
  "boundary": {
    "targetProjectRead": false,
    "targetProjectModified": false,
    "migrationIncluded": false,
    "integrationValidationIncluded": false
  }
}
